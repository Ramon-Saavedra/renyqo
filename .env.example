# Public URL of the deployed site.
# Used by Next metadata (metadataBase, OpenGraph, Twitter cards).
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL.
# Used by the frontend API client for all backend requests.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional credentials for the headed AI capture demo (npm run test:e2e:live).
E2E_BASE_URL=http://localhost:3001
E2E_PROVIDER_EMAIL=
E2E_PROVIDER_PASSWORD=
